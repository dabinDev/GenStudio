GENSTUDIO_ENV=production
DATABASE_URL=mysql+pymysql://genstudio:CHANGE_ME@mysql.internal:3306/genstudio?charset=utf8mb4

# Must be backed up. Rotating this changes session hashes and API key encryption.
GENSTUDIO_SECRET_KEY=replace-with-at-least-32-random-characters
GENSTUDIO_SESSION_COOKIE=genstudio_session
GENSTUDIO_COOKIE_SECURE=true
GENSTUDIO_COOKIE_SAMESITE=lax
GENSTUDIO_COOKIE_DOMAIN=
GENSTUDIO_FRONTEND_URL=https://studio.cylonai.cn
GENSTUDIO_CORS_ORIGINS=https://studio.cylonai.cn

GENSTUDIO_ENABLE_DEV_LOGIN=false
GENSTUDIO_AUTO_CREATE_TABLES=false

OFFICIAL_AUTH_EXCHANGE_URL=https://www.cylonai.cn/api/auth/exchange
OFFICIAL_AUTH_CLIENT_ID=genstudio
OFFICIAL_AUTH_CLIENT_SECRET=replace-with-official-client-secret

GENSTUDIO_REQUEST_TIMEOUT_SECONDS=180
GENSTUDIO_UPSTREAM_RETRY_ATTEMPTS=2
GENSTUDIO_RATE_LIMIT_WINDOW_SECONDS=60
GENSTUDIO_RATE_LIMIT_LOGIN_PER_WINDOW=20
GENSTUDIO_RATE_LIMIT_MODEL_TEST_PER_WINDOW=30
GENSTUDIO_RATE_LIMIT_GENERATION_PER_WINDOW=30
GENSTUDIO_RATE_LIMIT_UPLOAD_PER_WINDOW=40

OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_ENDPOINT_URL=https://oss.example.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=genstudio
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-object-storage-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-object-storage-secret-key
OBJECT_STORAGE_KEY_PREFIX=genstudio
OBJECT_STORAGE_PUBLIC_BASE_URL=https://oss.example.com/genstudio
